# Copia este archivo como `.env` para trabajar en local. En Vercel, estas mismas
# variables se ponen en Project → Settings → Environment Variables.
# Nunca subas llaves reales al repositorio.

# --- Supabase (obligatorias) ---
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="TU-PROYECTO"
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY=""          # secreta: solo en Vercel

# --- Marca ---
VITE_SITE_URL="https://www.tumarca.com"
VITE_META_PIXEL_ID=""                 # vacío = sin pixel
EMAIL_FROM=""                         # opcional; por defecto el de src/config/brand.ts

# --- IA (llave propia) ---
AI_PROVIDER="openai"                  # openai | google
OPENAI_API_KEY=""                     # texto (si AI_PROVIDER=openai), recortes de fotos y voz
GEMINI_API_KEY=""                     # texto (si AI_PROVIDER=google)
# AI_MODEL=""  AI_MODEL_FAST=""  AI_IMAGE_MODEL=""   # opcionales

# --- Correos ---
RESEND_API_KEY=""

# --- Meta (CAPI e informe de campañas) ---
META_ACCESS_TOKEN=""
META_PIXEL_ID=""

# --- Pagos ---
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
BOLD_ONLINE_API_KEY=""
BOLD_ONLINE_SECRET_KEY=""
BOLD_TERMINAL_API_KEY=""
BOLD_TERMINAL_SECRET_KEY=""
# PAYPAL_CLIENT_SECRET=""  ADDI_CLIENT_SECRET=""  ADDI_CALLBACK_PASSWORD=""

# --- Otros (opcionales) ---
FASHN_API_KEY=""                      # probador virtual
RWEAR_API_KEY=""                      # integración R Wear
READY_SYSTEM_KEY=""
ALLOWED_HOSTS=""                      # dominios extra permitidos para retornos de pago
